vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 20
  }
}

direction: right

classes: {
  device: {
    shape: rectangle
    style: {
      fill: "#f8f9fa"
      stroke: "#2563eb"
      stroke-width: 2
      border-radius: 8
      font-size: 16
      bold: true
    }
  }
  cloud: {
    shape: cloud
    style: {
      fill: "#eff6ff"
      stroke: "#3b82f6"
      stroke-width: 2
      font-size: 16
      bold: true
    }
  }
  action: {
    shape: hexagon
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      stroke-width: 2
      font-size: 15
      bold: true
    }
  }
}

pc: "Thiết Bị 1: Máy Tính (PC / Laptop)\nĐang đọc trang 152\nLưu tại LocalStorage" {
  class: device
}

mobile: "Thiết Bị 2: Điện Thoại (Mobile)\nTự động cập nhật trang 152\nĐồng bộ Bookmarks & History" {
  class: device
}

p1: "Cách 1: Quét Mã QR Tức Thì\n(Instant QR Handover Link)\nKhông cần Internet / Đăng ký" {
  class: action
}

p2: "Cách 2: Đám Mây Cloud Sync\n(Đồng bộ 2 chiều qua Sync Key)\nTự động cập nhật khi đổi trang" {
  class: cloud
}

p3: "Cách 3: Sao Lưu / Khôi Phục\n(Xuất/Nhập tệp dữ liệu JSON)" {
  class: action
}

pc -> p1: "1. Tạo mã QR chứa URL đồng bộ" {
  style: {
    stroke: "#d97706"
    stroke-width: 2
    font-size: 14
  }
}

p1 -> mobile: "2. Camera quét mã -> Mở đúng trang đọc dở" {
  style: {
    stroke: "#d97706"
    stroke-width: 2
    font-size: 14
  }
}

pc -> p2: "Lưu tiến độ đọc lên Cloud" {
  style: {
    stroke: "#2563eb"
    stroke-width: 2
    font-size: 14
  }
}

p2 -> mobile: "Tải tiến độ về Mobile bằng Sync Key" {
  style: {
    stroke: "#2563eb"
    stroke-width: 2
    font-size: 14
  }
}

pc -> p3: "Xuất file sao lưu" {
  style: {
    stroke: "#059669"
    stroke-width: 2
    stroke-dash: 4
    font-size: 14
  }
}

p3 -> mobile: "Nhập file dữ liệu" {
  style: {
    stroke: "#059669"
    stroke-width: 2
    stroke-dash: 4
    font-size: 14
  }
}
